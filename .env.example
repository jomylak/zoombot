# ---- Calendar ----
# Published Outlook ICS feed URL (see README step 1). Treat as a secret.
ICS_URL=

# ---- Filtering ----
# Literal tag you put in an event's title for the bot to join it.
AUTOJOIN_SUBJECT_TAG=[AutoJoin]
# How far ahead to look, and how often to poll (minutes)
LOOKAHEAD_MINUTES=120
POLL_INTERVAL_MINUTES=5
# Fire the joiner this many minutes before the scheduled start
JOIN_LEAD_MINUTES=2

# ---- Zoom ----
# Must match the display name on your Zoom account exactly.
ZOOM_DISPLAY_NAME=Your Name
ZOOM_EMAIL=you@example.com

# ---- Leave policy ----
# Leave at scheduled end, or early if participants drop below this
MIN_PARTICIPANTS=3
# Hard cap so a stuck session can never run forever (minutes)
MAX_SESSION_MINUTES=180
# Give up if we can't get in within this many minutes (waiting rooms)
JOIN_TIMEOUT_MINUTES=10

# ---- Notifications (ntfy.sh) ----
# Pick an unguessable topic name; anyone who knows it can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Attendance-check detection ----
# Watches for an on-screen QR code or attendance prompt while in a meeting,
# screenshots it, and sends an ntfy push with the screenshot attached.
ATTENDANCE_CHECK_ENABLED=true
ATTENDANCE_KEYWORDS=attendance,qr code,scan code,scan the code,check-in,checkin
# Minimum minutes between repeat alerts while the prompt stays on screen
ATTENDANCE_ALERT_COOLDOWN_MINUTES=10

# ---- Paths ----
STATE_DIR=~/.zoombot
