# ---- Calendar ----
# Published Outlook ICS feed URL (see README step 1). Treat as a secret.
ICS_URL=

# ---- Filtering ----
# Literal tag you put in an event's title for the bot to join it.
AUTOJOIN_SUBJECT_TAG=[AutoJoin]
# How far ahead to look, and how often to poll (minutes)
LOOKAHEAD_MINUTES=120
POLL_INTERVAL_MINUTES=5
# Fire the joiner this many minutes before the scheduled start
JOIN_LEAD_MINUTES=2

# ---- Zoom ----
# Must match the display name on your Zoom account exactly. Also used as
# the guest display name on every other platform (Teams, Meet, Webex, ...).
ZOOM_DISPLAY_NAME=Your Name
ZOOM_EMAIL=you@example.com

# ---- AI join agent (optional but recommended for non-Zoom platforms) ----
# Used to drive the join flow on a platform/link-shape we don't have
# selectors for yet, and to self-heal when a known platform's DOM changes.
# It records what it clicks so future joins of the same shape of meeting
# need it less and less -- see README. Get a key at openrouter.ai.
OPENROUTER_API_KEY=
# Free-tier OpenRouter model with both vision and tool-calling support
# (needed since the agent is shown a screenshot and calls tools each step).
# Free models are rate-limited (per-minute and per-day caps that vary by
# model/account) -- swap to a cheap paid model if you hit them often.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
AGENT_ENABLED=true
AGENT_MAX_STEPS=20
AGENT_STEP_TIMEOUT_S=25

# ---- Leave policy ----
# Leave at scheduled end, or early if participants drop below this
MIN_PARTICIPANTS=3
# Hard cap so a stuck session can never run forever (minutes)
MAX_SESSION_MINUTES=180
# Give up if we can't get in within this many minutes (waiting rooms)
JOIN_TIMEOUT_MINUTES=10

# ---- Notifications (ntfy.sh) ----
# Pick an unguessable topic name; anyone who knows it can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Attendance-check detection ----
# Watches for an on-screen QR code or attendance prompt while in a meeting,
# screenshots it, and sends an ntfy push with the screenshot attached.
ATTENDANCE_CHECK_ENABLED=true
ATTENDANCE_KEYWORDS=attendance,qr code,scan code,scan the code,check-in,checkin
# Minimum minutes between repeat alerts while the prompt stays on screen
ATTENDANCE_ALERT_COOLDOWN_MINUTES=10

# ---- Paths ----
STATE_DIR=~/.zoombot

# ---- Shared browser lock (optional) ----
# If something else on this machine also drives a headless Chromium (e.g. a
# job-discovery agent) and could contend for RAM at the same time, point
# both at the same BROWSER_LOCK_PATH so this bot always wins the handoff.
# No-op if nothing else on the box uses this path.
# BROWSER_LOCK_PATH=~/.applypilot/browser.lock
# BROWSER_YIELD_PATH=~/.applypilot/browser_yield_requested

# Notification limits (also: NOTIFY_PAUSED=true silences all pushes)
NOTIFY_PAUSED=false
NOTIFY_MAX_PER_WINDOW=6
NOTIFY_WINDOW_MINUTES=10
NOTIFY_DEDUPE_MINUTES=30
